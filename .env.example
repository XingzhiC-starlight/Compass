# Supabase connection — copy this file to `.env.local` and fill in the values
# from the Supabase dashboard (Project Settings → API). Both values are PUBLIC
# by design: the anon/publishable key only does what Row-Level Security allows.
# The service_role / secret key must NEVER appear here or anywhere in the repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Turnstile site key only — CAPTCHA is enabled on the Supabase project,
# so email auth needs it. The Turnstile secret key belongs in Supabase, never here.
VITE_TURNSTILE_SITE_KEY=
