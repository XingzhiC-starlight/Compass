# macOS
.DS_Store

# Secrets — NEVER commit these (Supabase keys, etc.)
.env
.env.*
!.env.example

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code — settings.json (the permission rules) and skills/ (the project's skills) ARE
# committed. Everything else under .claude/ is machine state (agent worktrees, local settings,
# the preview launch file).
.claude/*
!.claude/settings.json
!.claude/skills/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# design-sync machine state (config.json/NOTES.md/previews ARE committed)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# The browser checks' pictures, recordings and report.
browser/results/

# The verify-compass skill's evidence: pictures, page outlines, rows, logs, reports and the
# runs' made-up practice accounts.
verify-results/

# Supabase tool — its own scratch folders. The practice copy's settings
# (supabase/config.toml) ARE committed; a link to a hosted project never is.
supabase/.temp/
supabase/.branches/

# The desktop app as built (`npm run desktop`), and its check's pictures and report.
desktop/out/
desktop/results/
