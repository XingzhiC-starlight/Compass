{
  "name": "compass",
  "private": true,
  "version": "1.0.0",
  "description": "A calm focus and pacing dashboard for solo builders",
  "license": "MIT",
  "type": "module",
  "main": "desktop/out/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --project suite",
    "lint": "eslint . --max-warnings 0",
    "test:db": "node scripts/practice/cli.mjs test-db",
    "test:browser": "node scripts/practice/cli.mjs browser",
    "typecheck:browser": "tsc -p browser/tsconfig.json",
    "desktop": "node desktop/build.mjs && electron desktop/out/main.js",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json",
    "test:desktop": "node desktop/build.mjs && playwright test -c desktop/playwright.config.ts",
    "desktop:package": "node desktop/build.mjs && electron-builder --config desktop/package.config.mjs",
    "practice:up": "node scripts/practice/cli.mjs up",
    "practice:down": "node scripts/practice/cli.mjs down",
    "practice:reset": "node scripts/practice/cli.mjs reset",
    "practice:check": "node scripts/practice/cli.mjs check",
    "practice:app": "node scripts/practice/cli.mjs app",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.3",
    "vitest": "^5.1.0"
  }
}
